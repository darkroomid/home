---
import { getImage } from "astro:assets";
import { SEO } from "astro-seo";

// component import
import siteData from "@config/siteData";

interface BaseProps {
	title: string;
	description: string;
	noindex?: boolean;
}

interface GenProps extends BaseProps {
	type: "general" | undefined;
	image?: ImageMetadata;
}

const { title = "general", description, image, noindex = false } = Astro.props as GenProps;

let optimizedImage;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// if this is a blog page we do things differently
if (image) {
	optimizedImage = await getImage({
		src: image,
		format: "webp",
		quality: "high",
		width: 1200,
	});
}

function trimEndSlash(str: string) {
	if (str[str.length - 1] === "/") {
		return str.slice(0, -1);
	} else {
		return str;
	}
}

// put together the image URL
const imageUrl =
	trimEndSlash(Astro.site?.toString() || "") + (optimizedImage?.src || siteData.defaultImage.src);

// Every page previously rendered <title> as the bare page title with no site-name
// suffix at all (e.g. the About page's tab/SERP title was literally "About",
// Journal was literally "Journal") — no consistent brand signal in search
// results, browser tabs, or bookmarks. Appending the site name fixes that, while
// avoiding a doubled-up "Darkroom.id · Darkroom.id" on the homepage, whose title
// already *is* the site name.
const brandedTitle = title.trim() === siteData.title.trim() ? title : `${title} · ${siteData.title}`;
---

<SEO
	title={brandedTitle}
	description={description}
	canonical={canonicalUrl.toString()}
	openGraph={{
		basic: {
			title: brandedTitle,
			type: "website",
			image: imageUrl,
			url: canonicalUrl.toString(),
		},
		optional: {
			description: description,
			siteName: siteData.title,
		},
		image: {
			type: "image/webp",
			width: optimizedImage?.attributes.width || "1200",
			height: optimizedImage?.attributes.height || "800",
			alt: title,
		},
	}}
	twitter={{
		site: "@" + siteData.author.twitter,
		creator: "@" + siteData.author.twitter,
		card: "summary_large_image",
		title: brandedTitle,
		description: description,
		image: imageUrl,
	}}
	noindex={noindex}
	nofollow={noindex}
/>
