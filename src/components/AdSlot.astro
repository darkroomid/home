---
// Ad units must never render within a safety margin of nav/interactive elements
// (accidental-click risk — see google-adsense.md §11). This component is the only
// place ad markup is emitted, so that margin is applied consistently. Renders
// nothing at all until PUBLIC_ADSENSE_ENABLED=true (soft gate — don't enable until
// trust pages + the full initial article set are live, per the PRD's Day 4/Day 18
// gates), so an empty slot never lays out an invisible box during Phase 1.

interface Props {
	slotId: string; // AdSense ad-unit slot ID, once created in the AdSense dashboard
}

const { slotId } = Astro.props;
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === "true";
const publisherId = import.meta.env.PUBLIC_ADSENSE_PUBLISHER_ID;
---

{
	adsenseEnabled && (
		<div class="my-8 rounded-none border border-dashed border-base-300 p-2 text-center" data-ad-slot-id={slotId}>
			<ins
				class="adsbygoogle"
				style="display:block"
				data-ad-client={publisherId}
				data-ad-slot={slotId}
				data-ad-format="auto"
				data-full-width-responsive="true"
			/>
			<script is:inline>
				(adsbygoogle = window.adsbygoogle || []).push({});
			</script>
		</div>
	)
}
