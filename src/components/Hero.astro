---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

import { getImage } from "astro:assets";

// components
import Button from "@components/Button.astro";

// images
import heroImage from "@images/plane.jpg";

// Both breakpoints previously rendered as separate <Image> tags with only CSS
// `hidden`/`sm:hidden` toggling visibility — that doesn't stop the browser from
// requesting both, so every visitor downloaded two multi-megabyte hero images
// instead of one. A <picture> with a media-conditioned <source> means only the
// variant that actually matches loads.
const desktopHero = await getImage({ src: heroImage, height: 1400, format: "webp", quality: 80 });
const mobileHero = await getImage({ src: heroImage, width: 1200, format: "webp", quality: 80 });
---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
	<!-- background image -->
	<div class="absolute -z-10 h-full min-h-full w-full overflow-hidden">
		<div class="absolute inset-0 bg-black/10"></div>

		<picture>
			<source media="(min-width: 640px)" srcset={desktopHero.src} width={desktopHero.attributes.width} height={desktopHero.attributes.height} />
			<img
				src={mobileHero.src}
				width={mobileHero.attributes.width}
				height={mobileHero.attributes.height}
				class="h-auto min-h-full w-full object-cover object-bottom"
				alt="wedding"
				aria-hidden="true"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
		<!-- Hero text -->
		<div class="text-base-50 my-auto mr-auto max-w-[800px] flex-col">
			<h1
				class="font-heading-1 text-4xl text-black font-semibold text-pretty drop-shadow-[0_4px_4px_rgba(0,0,0,0.5)] md:text-7xl md:leading-tight"
			>
				Dark Side of the Room
			</h1>
			<p
				class="font-heading-1 text-primary-100 mt-8 text-lg font-normal tracking-wide drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:max-w-[550px] md:text-2xl"
			>
                I trust pictures not words.
            </p>
            <div class="mt-10 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="ghost"
					arrow="right"
                    href="/collections/favourite"
					class="pl-0 text-xl text-black drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:text-2xl"
				>
					Collections
				</Button>
			</div>
		</div>
	</div>
</section>
