---
// Article schema.org JSON-LD, rendered directly from Content Collections frontmatter.
import BaseLayout from "@layouts/BaseLayout.astro";
import AdSlot from "@components/AdSlot.astro";
import { Image } from "astro:assets";
import { slugify } from "@/utils/slug";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	author: string;
	targetKeyword: string;
	contentCluster: string;
	schemaType: "Article" | "FAQPage";
	heroImage?: ImageMetadata;
	heroImageAlt?: string;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	author,
	contentCluster,
	schemaType,
	heroImage,
	heroImageAlt,
} = Astro.props as Props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const articleSchema = {
	"@context": "https://schema.org",
	"@type": schemaType,
	headline: title.slice(0, 110),
	author: {
		"@type": "Person",
		name: author,
	},
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalURL,
	},
};

// BreadcrumbList — supports Google's breadcrumb rich result and gives crawlers
// an explicit sense of site hierarchy (Home > Journal > Cluster > Article),
// which article pages had no structured signal for before.
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
		{ "@type": "ListItem", position: 2, name: "Journal", item: `${siteUrl}/journal` },
		{
			"@type": "ListItem",
			position: 3,
			name: contentCluster,
			item: `${siteUrl}/journal/cluster/${slugify(contentCluster)}`,
		},
		{ "@type": "ListItem", position: 4, name: title, item: canonicalURL },
	],
};
---

<BaseLayout title={title} description={description} heroImage={heroImage}>
	<article class="site-container max-w-3xl pt-24 pb-16 md:pt-36">
		<p class="mb-4">
			<a href="/journal" class="description hover:text-primary-600 text-sm tracking-wide uppercase transition"
				>&larr; All articles</a
			>
		</p>
		<header class="mb-8 border-b border-base-200 pb-6">
			<div class="description mb-3 flex flex-wrap items-center gap-3 text-sm">
				<a
					href={`/journal/cluster/${slugify(contentCluster)}`}
					class="bg-primary-100 text-primary-700 rounded-full px-3 py-1 font-medium">{contentCluster}</a
				>
				<span
					>Published {
						pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
					}</span
				>
				{
					updatedDate && (
						<span>
							Updated {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
						</span>
					)
				}
			</div>
			<h1 class="h1">{title}</h1>
			<p class="description mt-2 text-sm">By {author}</p>
		</header>

		{
			heroImage && (
				<Image
					src={heroImage}
					alt={heroImageAlt ?? ""}
					width={1200}
					densities={[1.5, 2]}
					class="mb-8 aspect-video w-full rounded-none object-cover"
				/>
			)
		}

		<div class="markdown-content text-sm md:text-base">
			<slot />
		</div>

		<AdSlot slotId="article-bottom" />

		<div class="mt-12 flex items-start gap-4 border-t border-base-200 pt-8">
			<div
				class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary-400 to-primary-600 font-heading-1 text-white"
			>
				{author.split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]?.toUpperCase()).join("")}
			</div>
			<div>
				<p class="font-heading-1 font-medium">{author}</p>
				<p class="description text-sm">
					Reviews and writes about gear, technique, and editing for darkroom.id.
				</p>
			</div>
		</div>
	</article>

	<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
