---
// Each content cluster gets a real, pre-rendered static page (not client-side
// query-param filtering, which doesn't work on a static-output build).
//
// The route param is a clean ASCII slug (see src/utils/slug.ts), not the raw
// cluster name with spaces/"&" — percent-encoding those in a dynamic route
// segment proved unreliable across Astro dev/build (404s even when
// getStaticPaths and the link agreed on the encoding). The slug sidesteps that
// entirely; the pretty name is still used for display via props.
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { slugify } from "@/utils/slug";

export async function getStaticPaths() {
	const articles = await getCollection("articles", ({ data }) => !data.draft);
	const clusters = [...new Set(articles.map((a) => a.data.contentCluster))];
	return clusters.map((cluster) => ({
		params: { cluster: slugify(cluster) },
		props: {
			cluster,
			articles: articles
				.filter((a) => a.data.contentCluster === cluster)
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { cluster, articles } = Astro.props;
---

<BaseLayout title={cluster} description={`Gear reviews, tutorials, and editing guides in the ${cluster} cluster on darkroom.id.`}>
	<section class="site-container pt-24 pb-4 text-center md:pt-36">
		<h1 class="h1">{cluster}</h1>
		<p class="description mx-auto mt-4 max-w-xl">
			Articles from the Journal, filtered to this cluster.
		</p>
	</section>

	<section class="site-container py-8 md:py-12">
		{articles.length === 0 && <p class="description text-center">No articles in this cluster yet.</p>}
		<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				articles.map((article) => (
					<a href={`/journal/${article.id}`} class="group block">
						{article.data.heroImage && (
							<div class="aspect-video w-full overflow-hidden">
								<Image
									src={article.data.heroImage}
									alt={article.data.heroImageAlt ?? ""}
									width={640}
									class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
								/>
							</div>
						)}
						<div class="mt-3">
							<h2 class="font-heading-1 mt-1 text-xl font-medium group-hover:opacity-80">
								{article.data.title}
							</h2>
							<p class="description mt-1 text-sm">{article.data.description}</p>
						</div>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>
