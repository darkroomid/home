---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { slugify } from "@/utils/slug";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
	title="Journal"
	description="Gear reviews, tutorials, and editing guides from darkroom.id."
>
	<section class="site-container pt-24 pb-4 text-center md:pt-36">
		<h1 class="h1">Journal</h1>
		<p class="description mx-auto mt-4 max-w-xl">
			Gear reviews, technique tutorials, and editing guides — shot, tested, and written by us.
		</p>
	</section>

	<section class="site-container py-8 md:py-12">
		{articles.length === 0 && <p class="description text-center">No articles published yet.</p>}
		<div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
			{
				articles.map((article) => (
					<article class="group">
						<a href={`/journal/${article.id}`} class="block">
							{article.data.heroImage && (
								<div class="aspect-video w-full overflow-hidden">
									<Image
										src={article.data.heroImage}
										alt={article.data.heroImageAlt ?? ""}
										width={640}
										class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
									/>
								</div>
							)}
						</a>
						<div class="mt-3">
							<a
								href={`/journal/cluster/${slugify(article.data.contentCluster)}`}
								class="text-primary-600 text-xs font-medium tracking-wide uppercase hover:underline"
							>
								{article.data.contentCluster}
							</a>
							<a href={`/journal/${article.id}`} class="block">
								<h2 class="font-heading-1 mt-1 text-xl font-medium group-hover:opacity-80">
									{article.data.title}
								</h2>
								<p class="description mt-1 text-sm">{article.data.description}</p>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>
