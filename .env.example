# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# All PUBLIC_ vars are exposed client-side by Astro — do not put secrets here.

# GA4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AdSense Publisher ID, e.g. ca-pub-xxxxxxxxxxxxxxxx (issued at AdSense signup)
PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx

# Soft gate — set to "true" only once trust pages + the full initial article set
# are live AND the Publisher ID above is real.
PUBLIC_ADSENSE_ENABLED=false

# Google Search Console HTML-tag verification content string
# (Search Console -> Settings -> Ownership verification -> HTML tag -> the "content" value only)
PUBLIC_SEARCH_CONSOLE_VERIFICATION=
